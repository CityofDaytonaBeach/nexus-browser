import("../../../scripts/build/ninja/devtools_entrypoint.gni")
import("../../../scripts/build/ninja/devtools_module.gni")
import("../../../scripts/build/ninja/generate_css.gni")

generate_css("css_files") {
  sources = [ "nexusPanel.css" ]
}

devtools_ui_module("nexus") {
  sources = [ "NexusPanel.ts" ]

  deps = [ ":css_files" ]

  ts_deps = [
    "../../core/host:bundle",
    "../../core/i18n:bundle",
    "../../core/sdk:bundle",
    "../../ui/helpers:bundle",
    "../../ui/legacy:bundle",
    "../../ui/lit:bundle",
  ]
}

devtools_entrypoint("bundle") {
  entrypoint = "nexus.ts"
  deps = [ ":css_files" ]
  ts_deps = [ ":nexus" ]
  visibility = [
    ":*",
    "../../entrypoints/*",
  ]
}

devtools_entrypoint("meta") {
  entrypoint = "nexus-meta.ts"
  ts_deps = [
    ":bundle",
    "../../core/i18n:bundle",
    "../../ui/legacy:bundle",
  ]
  visibility = [ "../../entrypoints/*" ]
}
