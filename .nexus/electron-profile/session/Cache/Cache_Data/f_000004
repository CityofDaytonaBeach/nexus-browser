  <script>
    const apiKey = 'nexus-dev-key';
    let ws = null;
    let currentSessionId = null;
    let currentPageId = null;
    let viewMode = 'preview';
    let lastScreenshot = null;
    let overlayTimer = null;
    let pendingAutoBuild = null;
    let pendingNavigateUrl = null;
    let activeBuildId = null; // Restored from the selected chat, never a global project ID.
    let previewLogTimer = null;
    let buildProgressTimer = null;
    let browserIntelTimer = null;
    let pendingResearchAfterLoad = false;
    let lastBrowserIntelligence = '';
    let lastGathererObservationCount = 0;
    let lastBackendObservation = '';
    let lastBackendObservationCount = 0;
    let activeTabId = 'home';
    let landingStartInProgress = false;
    let chatRequestInProgress = false;
    let csrfToken = '';
    let activeChatId = localStorage.getItem('nexus-active-chat-id') || '';
    let popoutChatId = '';
    let chatPopoutWindow = null;
    const chatWindowId = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    const chatSyncChannel = typeof BroadcastChannel === 'function' ? new BroadcastChannel('nexus-chat-sync') : null;
    const nexusStatusLog = [];
    const browserTabs = [{ id: 'home', title: 'Home', kind: 'home', url: '' }];

    function upsertBrowserTab(tab) {
      const existing = browserTabs.find(item => item.id === tab.id);
      if (existing) Object.assign(existing, tab);
      else browserTabs.push(tab);
      activeTabId = tab.id;
      renderBrowserTabs();
    }

    function renderBrowserTabs() {
      const el = document.getElementById('browserTabs');
      if (!el) return;
      el.innerHTML = browserTabs.map(tab => `<button class="browser-tab ${tab.id === activeTabId ? 'active' : ''}" onclick="activateBrowserTab('${tab.id}')"><span>${tab.title}</span></button>`).join('');
    }

    function activateBrowserTab(id) {
      const tab = browserTabs.find(item => item.id === id);
      if (!tab) return;
      activeTabId = id;
      renderBrowserTabs();
      if (tab.kind === 'ide') return showBrowserFrame('IDE', tab.url, 'Traditional file/folder coding workspace');
      if (tab.kind === 'page') return showBrowserFrame('Browser', tab.url, tab.title);
      if (tab.kind === 'preview') return openActiveBuildExternal();
    }

    function showBrowserFrame(label, url, title) {
      document.getElementById('browserView').innerHTML = `<div class="hud"><span class="pill">${label}</span><span class="pill">${title}</span></div><div class="preview-actions"><button class="btn" onclick="window.open('${url}', '_blank', 'noopener,noreferrer')">Open</button></div><iframe class="app-frame" src="${url}" title="${title}"></iframe>`;
      setText('pageStatus', `${label} - ${url}`);
      document.getElementById('urlInput').value = url;
    }

    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    }

    function setLaunchStatus(value) {
      setText('launchStatus', value);
      appendStream('qaStream', value);
    }

    function setLandingStatus(value) {
      setText('landingStatus', value);
    }

    const modePresentation = {
      build: { label: 'Agent', action: 'Build', placeholder: 'Describe what you want Nexus to build, or enter a URL' },
      chat: { label: 'Ask', action: 'Ask', placeholder: 'Ask about a project, codebase, or technical decision' },
      plan: { label: 'Plan', action: 'Plan', placeholder: 'Describe the product or change you want planned' },
      'ui-builder': { label: 'Visual edit', action: 'Edit', placeholder: 'Describe the visual change, or enter a page URL' },
      research: { label: 'Research', action: 'Research', placeholder: 'Enter a topic, product question, or URL to research' },
    };

    function syncBuilderMode(mode, { persist = true, announce = true } = {}) {
      if (!modePresentation[mode]) return;
      const landingMode = document.getElementById('landingMode');
      const builderMode = document.getElementById('builderMode');
      if (landingMode) landingMode.value = mode;
      if (builderMode) builderMode.value = mode;
      if (persist) localStorage.setItem('nexus-builder-mode', mode);
      const input = document.getElementById('landingChatInput');
      const submit = document.getElementById('landingSubmit');
      if (input) input.placeholder = modePresentation[mode].placeholder;
      if (submit && !landingStartInProgress) submit.textContent = modePresentation[mode].action;
      setLandingStatus(`${modePresentation[mode].label} mode`);
      if (announce) appendStream('researchStream', `Mode: ${mode}`);
    }

    function setLandingBusy(busy, mode) {
      landingStartInProgress = busy;
      const submit = document.getElementById('landingSubmit');
      const input = document.getElementById('landingChatInput');
      const select = document.getElementById('landingMode');
      if (submit) {
        submit.disabled = busy;
        submit.textContent = busy ? 'Starting...' : (modePresentation[mode]?.action || 'Start');
      }
      if (input) input.disabled = busy;
      if (select) select.disabled = busy;
    }

    function enterProjectLiveMode(url, prompt) {
      document.body.classList.remove('landing-first', 'chat-first');
      document.body.classList.add('project-live');
      document.getElementById('chatPanel').classList.add('open');
      document.getElementById('browserView').innerHTML = `
        <div class="live-build-card">
          <div class="live-build-inner">
            <h1>Building from the live web.</h1>
            <p>Nexus is opening ${escapeHtml(url)}, gathering browser evidence, asking only needed setup questions, then routing the project through OpenCode, preview, staging, and visual QA.</p>
            <div class="build-pipeline"><span>Open URL</span><span>Research</span><span>OpenCode</span><span>Visual QA</span></div>
            <div class="launch-status" id="launchStatus">Starting live project...</div>
          </div>
        </div>`;
      document.getElementById('chatPanel').style.display = 'flex';
      addMessage('system', `Project live window opened for ${url}. Chat is now controlling research, build, staging, and QA.`);
      document.getElementById('chatInput').value = prompt;
    }

    async function continueBuildFromLoadedPage(message) {
      try {
        await refreshBrowserIntelligence(true);
        await refreshBackendObserver(true);
        addMessage('user', message);
        const result = await api('/api/builder/chat', {
          chatId: chatApiId(),
          sessionId: currentSessionId,
          pageId: currentPageId,
          activeBuildId,
          message,
          browserContext: `${lastBrowserIntelligence}\n\n${lastBackendObservation}`.trim(),
          mode: 'build',
          uiLook: document.getElementById('uiLook').value,
          ...buildBrainOptions(),
        });
        if (result.chatId) {
          const currentTitle = document.getElementById('activeChatTitle')?.textContent || '';
          setActiveChat(result.chatId, currentTitle && currentTitle !== 'Nexus Chat' ? currentTitle : message, result.projectId || null);
          if (result.sessionId) currentSessionId = result.sessionId;
          if (result.pageId) currentPageId = result.pageId;
        }
        addMessage('assistant', result.response);
        if (result.build) showBuildStarted(result.build);
        if (result.update) showBuildUpdateStarted(result.update);
        if (result.requiresInput) setLaunchStatus('Waiting for the requested setup information.');
      } catch (error) {
        addMessage('system', `Build handoff failed: ${error.message}`);
      } finally {
        document.getElementById('chatInput').value = '';
      }
    }

    function initTheme() {
      const saved = localStorage.getItem('nexus-theme') || 'light';
      document.documentElement.dataset.theme = saved;
      document.getElementById('themeToggle').textContent = saved === 'dark' ? 'Light Mode' : 'Dark Mode';
    }

    function toggleTheme() {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('nexus-theme', next);
      document.getElementById('themeToggle').textContent = next === 'dark' ? 'Light Mode' : 'Dark Mode';
    }

    function toggleTools(force) {
      const panel = document.getElementById('toolsPanel');
      panel.classList.toggle('open', typeof force === 'boolean' ? force : !panel.classList.contains('open'));
    }

    function toggleChat(force) {
      const panel = document.getElementById('chatPanel');
      if (document.body.classList.contains('chat-popout')) {
        panel.classList.add('open');
        document.getElementById('chatInput').focus();
        return;
      }
      if (force === true || panel.classList.contains('minimized')) {
        setChatMinimized(false);
        panel.classList.add('open');
      } else {
        panel.classList.toggle('open', typeof force === 'boolean' ? force : !panel.classList.contains('open'));
      }
      if (panel.classList.contains('open')) document.getElementById('chatInput').focus();
    }

    function setChatMinimized(minimized, persist = true) {
      if (document.body.classList.contains('chat-popout')) minimized = false;
      const panel = document.getElementById('chatPanel');
      panel.classList.toggle('minimized', minimized);
      if (minimized) panel.classList.add('open');
      const button = document.getElementById('chatMinimizeButton');
      const icon = document.getElementById('chatMinimizeIcon');
      const label = minimized ? 'Restore chat' : 'Minimize chat';
      if (button) {
        button.setAttribute('aria-label', label);
        button.title = label;
      }
      if (icon) icon.textContent = minimized ? '+' : '\u2212';
      if (persist) localStorage.setItem('nexus-chat-minimized', minimized ? 'true' : 'false');
    }

    function minimizeChat() {
      const panel = document.getElementById('chatPanel');
      setChatMinimized(!panel.classList.contains('minimized'));
      if (!panel.classList.contains('minimized')) document.getElementById('chatInput').focus();
    }

    function popoutChat() {
      const chatId = activeChatId || '';
      const hash = chatId ? `#chat=${encodeURIComponent(chatId)}` : '#chat';
      const url = `${location.origin}${location.pathname}${location.search}${hash}`;
      if (chatPopoutWindow && !chatPopoutWindow.closed) {
        chatPopoutWindow.postMessage({ type: 'nexus-chat-open', chatId, source: chatWindowId }, location.origin);
        chatPopoutWindow.focus();
      } else {
        chatPopoutWindow = window.open(url, 'nexus-chat', 'popup=yes,width=430,height=720,menubar=no,toolbar=no,location=no,status=no,resizable=yes,scrollbars=yes');
      }
      if (!chatPopoutWindow) {
        addMessage('system', 'The chat window was blocked. Allow popups for Nexus, then try again.');
        return;
      }
      if (chatId) {
        setTimeout(() => chatPopoutWindow?.postMessage({ type: 'nexus-chat-open', chatId, source: chatWindowId }, location.origin), 250);
      }
      setChatMinimized(true);
    }

    function initWindowMode() {
      const hashParams = new URLSearchParams(location.hash.slice(1));
      const isChatPopout = location.hash === '#chat' || hashParams.has('chat');
      if (isChatPopout) {
        popoutChatId = hashParams.get('chat') || activeChatId;
        document.body.classList.remove('landing-first', 'chat-first', 'project-live');
        document.body.classList.add('chat-popout');
        const panel = document.getElementById('chatPanel');
        panel.classList.add('open');
        panel.classList.remove('minimized');
        document.title = 'Nexus Chat';
        setChatMinimized(false, false);
      } else if (localStorage.getItem('nexus-chat-minimized') === 'true') {
        setChatMinimized(true, false);
      }
    }

    function returnChatToWorkspace() {
      if (window.opener && !window.opener.closed) {
        window.opener.postMessage({ type: 'nexus-chat-return', source: chatWindowId }, location.origin);
        window.opener.focus();
        window.close();
        return;
      }
      location.href = location.pathname + location.search;
    }

    async function refreshSyncedChat(chatId) {
      if (!chatId || chatId !== activeChatId || chatRequestInProgress) return;
      try {
        const chat = await getApi(`/api/chats/${encodeURIComponent(chatId)}`);
        if (chat.id === activeChatId) renderChatMessages(chat.messages || [], chat.title);
      } catch {}
    }

    function broadcastChatUpdate() {
      if (!activeChatId) return;
      const detail = { type: 'nexus-chat-updated', chatId: activeChatId, source: chatWindowId, at: Date.now() };
      chatSyncChannel?.postMessage(detail);
      localStorage.setItem('nexus-chat-sync', JSON.stringify(detail));
    }

    function handleChatSync(detail) {
      if (!detail || detail.source === chatWindowId || detail.type !== 'nexus-chat-updated') return;
      refreshSyncedChat(detail.chatId);
    }

    if (chatSyncChannel) chatSyncChannel.onmessage = (event) => handleChatSync(event.data);
    window.addEventListener('storage', (event) => {
      if (event.key !== 'nexus-chat-sync' || !event.newValue) return;
      try { handleChatSync(JSON.parse(event.newValue)); } catch {}
    });
    window.addEventListener('message', (event) => {
      if (event.origin !== location.origin) return;
      if (event.data?.type === 'nexus-chat-return') {
        setChatMinimized(false);
        toggleChat(true);
      } else if (event.data?.type === 'nexus-native-tab-context') {
        lastBrowserIntelligence = String(event.data.context || '');
        lastGathererObservationCount += 1;
        currentSessionId = 'electron-native';
        currentPageId = String(event.data.tabId || currentPageId || 'active-tab');
        setText('sessionPill', 'native');
        const gathererStatus = document.getElementById('gathererStatus');
        if (gathererStatus) gathererStatus.textContent = 'native tab live';
        setText('pageStatus', `Native Chromium tab - ${event.data.title || event.data.url || 'active page'}`);
        if (event.data.url) document.getElementById('urlInput').value = event.data.url;
        handleBrowserPageLoaded();
      } else if (event.data?.type === 'nexus-chat-open' && document.body.classList.contains('chat-popout')) {
        const nextChatId = String(event.data.chatId || '');
        if (!nextChatId) return;
        popoutChatId = nextChatId;
        history.replaceState(null, '', `${location.pathname}${location.search}#chat=${encodeURIComponent(nextChatId)}`);
        openChat(nextChatId, { announce: false });
      }
    });

    function headers() { return { 'x-api-key': apiKey, 'x-csrf-token': csrfToken, 'Content-Type': 'application/json' }; }

    async function loadSecurityToken() {
      const res = await fetch('/api/security/csrf', { headers: { 'x-api-key': apiKey } });
      if (res.ok) csrfToken = (await res.json()).token || '';
    }

    function buildBrainOptions() {
      return {
        brainMode: document.getElementById('brainMode')?.value || 'hybrid',
        aiProvider: document.getElementById('aiProvider')?.value || 'openai',
        aiModel: document.getElementById('aiModel')?.value.trim() || undefined,
      };
    }

    function chatApiId() {
      return activeChatId || currentSessionId || 'default';
    }

    function setActiveChat(id, title, projectId = null) {
      if (activeChatId !== id && buildProgressTimer) { clearTimeout(buildProgressTimer); buildProgressTimer = null; }
      activeBuildId = projectId;
      lastBackendObservation = '';
      document.getElementById('outputPath').textContent = '';
      activeChatId = id || '';
      if (activeChatId) localStorage.setItem('nexus-active-chat-id', activeChatId);
      else localStorage.removeItem('nexus-active-chat-id');
      setText('activeChatTitle', title ? compactLabel(title, 34) : 'Nexus Chat');
    }

    function renderChatMessages(messages, title) {
      const el = document.getElementById('messages');
      el.innerHTML = '';
      if (!Array.isArray(messages) || !messages.length) {
        addMessage('system', 'New Nexus chat ready. Ask, build, fix, QA, deploy, or call an agent.');
      } else {
        const progressRefs = messages.map((message) => extractBuildReference(message));
        const latestProgressIndex = progressRefs.reduce((latest, ref, index) => ref ? index : latest, -1);
        messages.forEach((message, index) => {
          const ref = progressRefs[index];
          if (ref && index === latestProgressIndex) {
            const card = createBuildProgressMessage(ref.buildId, Boolean(ref.updateId));
            monitorBuildProgress(ref.buildId, ref.updateId || '', card);
          } else {
            addMessage(message.role || 'system', message.content || '');
          }
        });
      }
      if (title) setText('activeChatTitle', compactLabel(title, 34));
    }

    function extractBuildReference(message) {
      if (!message || message.role !== 'assistant') return null;
      if (message.buildId) return { buildId: String(message.buildId), updateId: message.updateId ? String(message.updateId) : '' };
      const content = String(message.content || '');
      if (!/^Build started\.|^App update |^Nexus (?:build|app update)/i.test(content)) return null;
      const explicitBuild = content.match(/Build ID:\s*([a-f0-9]{8})/i);
      const workspaceBuild = content.match(/generated-apps[\\/][^\n]*-([a-f0-9]{8})(?:\r?\n|$)/i);
      const update = content.match(/(?:Update ID:\s*|chat-updates[\\/])([a-f0-9]{8})/i);
      const buildId = explicitBuild?.[1] || workspaceBuild?.[1];
      return buildId ? { buildId, updateId: update?.[1] || '' } : null;
    }

    function compactLabel(value, max = 72) {
      const text = String(value || '').replace(/\s+/g, ' ').trim();
      return text.length > max ? `${text.slice(0, max - 3)}...` : text;
    }

    function formatTime(value) {
      if (!value) return 'not updated yet';
      return new Date(value).toLocaleString();
    }

    async function api(path, body, options = {}) {
      const controller = new AbortController();
      const timeoutMs = Number(options.timeoutMs || 0);
      const timeout = timeoutMs ? setTimeout(() => controller.abort(), timeoutMs) : null;
      try {
        const res = await fetch(path, { method: 'POST', headers: headers(), body: JSON.stringify(body || {}), signal: controller.signal });
        const text = await res.text();
        let payload = {};
        try { payload = text ? JSON.parse(text) : {}; } catch { payload = { error: text }; }
        if (!res.ok) throw new Error(payload.error || text || `Request failed (${res.status})`);
        return payload;
      } catch (error) {
        if (error.name === 'AbortError') throw new Error(`Request timed out after ${Math.round(timeoutMs / 1000)} seconds.`);
        throw error;
      } finally {
        if (timeout) clearTimeout(timeout);
      }
    }

    async function deleteApi(path) {
      const res = await fetch(path, { method: 'DELETE', headers: headers() });
      if (!res.ok) throw new Error(await res.text());
      return res.json();
    }

    async function getApi(path) {
      const res = await fetch(path, { headers: { 'x-api-key': apiKey } });
      if (!res.ok) throw new Error(await res.text());
      return res.json();
    }

    function connect() {
      ws = new WebSocket(`ws://${location.host}`);
      ws.onopen = () => { setStatus(true, 'Connected'); ws.send(JSON.stringify({ type: 'auth', apiKey })); };
      ws.onclose = () => { setStatus(false, 'Disconnected'); setTimeout(connect, 2000); };
      ws.onmessage = (event) => handleWs(JSON.parse(event.data));
    }

    function handleWs(msg) {
      if (msg.type === 'auth:success') {
        if (nativeBrowserAvailable()) sendWs('native-browser:register');
        else sendWs('session:list');
        addMessage('system', 'Builder ready. Enter a URL or ask research/plan/build mode to begin.');
      }
      if (msg.type === 'native-browser:registered') {
        currentSessionId = 'electron-native';
        currentPageId = currentPageId || 'active-tab';
        setText('sessionPill', 'native');
        setText('pageStatus', 'Native Chromium control connected');
      }
      if (msg.type === 'native-browser:action') handleNativeBrowserRequest(msg);
      if (msg.type === 'session:created') {
        currentSessionId = msg.session.id;
        currentPageId = msg.session.activePageId || msg.session.pages[0]?.id;
        setText('sessionPill', currentSessionId.slice(0, 8));
        addMessage('system', `Session ready: ${currentSessionId}`);
        if (pendingNavigateUrl) {
          const url = pendingNavigateUrl;
          pendingNavigateUrl = null;
          navigateToUrl(url);
        }
      }
      if (msg.type === 'session:attached') {
        currentSessionId = msg.session.id;
        currentPageId = msg.session.activePageId || msg.session.pages[0]?.id;
        setText('sessionPill', currentSessionId.slice(0, 8));
        addMessage('system', `Attached to existing session: ${currentSessionId}`);
        refreshScreenshot();
      }
      if (msg.type === 'sessions') attachOrCreateSession(msg.sessions || []);
      if (msg.type === 'action:result' && msg.result?.page) {
        if (currentSessionId === 'electron-native') applyNativeActionResult(msg.result, {});
        else updatePage(msg.result.page);
      }
      if (msg.type === 'page:screenshot' && !document.body.classList.contains('landing-first')) showScreenshot(msg.data);
      if (msg.type === 'page:navigated') document.getElementById('urlInput').value = msg.url;
      if (msg.type === 'page:loaded') {
        refreshScreenshot();
        refreshBrowserIntelligence(true);
        handleBrowserPageLoaded();
      }
      if (msg.type === 'error') addMessage('system', msg.error);
    }

    function sendWs(type, data = {}) {
      if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ type, ...data }));
    }

    function nativeBrowserAvailable() {
      return Boolean(window.nexusNativeBrowser?.action);
    }

    function describeNativeAction(action = {}) {
      const detail = action.url || action.selector || action.value || '';
      return `${action.type || 'action'}${detail ? ` ${compactLabel(detail, 56)}` : ''}`;
    }

    function applyNativeActionResult(result, action = {}) {
      if (result?.page) {
        currentSessionId = 'electron-native';
        currentPageId = result.page.id || currentPageId || 'active-tab';
        document.getElementById('urlInput').value = result.page.url || '';
        setText('pageStatus', `Native Chromium tab - ${result.page.title || result.page.url || 'active page'}`);
      }
      if (result?.data?.screenshot) showScreenshot(result.data.screenshot);
      if (action.type === 'navigate' || action.type === 'back' || action.type === 'forward' || action.type === 'reload') handleBrowserPageLoaded();
    }

    async function executeNativeBrowserAction(action, options = {}) {
      if (!nativeBrowserAvailable()) throw new Error('Native Chromium control is not available in this window.');
      const label = describeNativeAction(action);
      if (options.announce !== false) {
        appendStream('researchStream', `Native browser agent: ${label}`);
        addMessage('system', `Browser agent is executing: ${label}`);
      }
      const result = await window.nexusNativeBrowser.action(action);
      applyNativeActionResult(result, action);
      if (!result?.success) throw new Error(result?.error || 'Native browser action failed');
      if (options.announce !== false) addMessage('system', `Browser action complete: ${label}`);
      return result;
    }

    async function handleNativeBrowserRequest(msg) {
      const action = msg.action || {};
      try {
        const result = await executeNativeBrowserAction(action, { announce: true });
        sendWs('native-browser:result', { requestId: msg.requestId, result });
      } catch (error) {
        sendWs('native-browser:result', {
          requestId: msg.requestId,
          result: { success: false, error: error.message, duration: 0 },
        });
      }
    }

    function handleBrowserPageLoaded() {
      if (pendingResearchAfterLoad) {
        pendingResearchAfterLoad = false;
        addMessage('system', 'Browser page loaded. Resuming research project...');
        setTimeout(() => runResearchProject(), 1200);
        return;
      }
      if (pendingAutoBuild) {
        const message = pendingAutoBuild;
        pendingAutoBuild = null;
        addMessage('system', 'Target page loaded. Collecting evidence, then starting OpenCode build and staging...');
        setTimeout(() => continueBuildFromLoadedPage(message), 900);
      }
    }

    function newSession() { sendWs('session:create'); }

    function attachOrCreateSession(sessions) {
      if (nativeBrowserAvailable()) {
        currentSessionId = 'electron-native';
        currentPageId = currentPageId || 'active-tab';
        return;
      }
      if (document.body.classList.contains('landing-first')) return;
      const existing = sessions.find(session => session.pages?.some(page => page.url && !page.url.startsWith('http://localhost:3000') && page.url !== 'about:blank'));
      if (existing) {
        sendWs('session:attach', { sessionId: existing.id });
      } else {
        addMessage('system', 'No target browser session yet. One will be created when you navigate or start building from a URL.');
      }
    }

    function navigate() {
      const raw = document.getElementById('urlInput').value.trim();
      if (!raw) return;
      const looksLikeUrl = /^https?:\/\//i.test(raw) || /^[a-z0-9.-]+\.[a-z]{2,}(?:\/[^\s]*)?$/i.test(raw);
      if (!looksLikeUrl) {
        runBrowserSearch(raw);
        return;
      }
      const url = raw.startsWith('http') ? raw : `https://${raw}`;
      upsertBrowserTab({ id: `page-${Date.now()}`, title: new URL(url).hostname, kind: 'page', url });
      if (nativeBrowserAvailable()) {
        navigateToUrl(url);
        return;
      }
      if (!currentPageId) {
        pendingNavigateUrl = url;
        appendStream('researchStream', `Creating target browser session for ${url}`);
        newSession();
        return;
      }
      navigateToUrl(url);
    }

    async function runBrowserSearch(query) {
      try {
        upsertBrowserTab({ id: `search-${Date.now()}`, title: query, kind: 'search', url: query });
        document.getElementById('browserView').innerHTML = `<div class="hud"><span class="pill">Search</span><span class="pill">${query}</span></div><div class="search-page"><h1>Searching ${query}</h1><p>Finding pages, docs, APIs, repos, and implementation clues.</p></div>`;
        const payload = await getApi(`/api/browser/search?q=${encodeURIComponent(query)}`);
        showSearchResults(payload.query, payload.results || []);
      } catch (error) {
        addMessage('system', `Search failed: ${error.message}`);
      }
    }

    function showSearchResults(query, results) {
      document.getElementById('browserView').innerHTML = `<div class="hud"><span class="pill">Search</span><span class="pill">${results.length} results</span></div><div class="search-page"><h1>${query}</h1>${results.map((result) => `<article class="search-result" onclick="openSearchResult('${encodeURIComponent(result.url)}','${encodeURIComponent(result.title)}')"><b>${result.title}</b><small>${result.url}</small><p>${result.snippet || ''}</p></article>`).join('') || '<p>No results found.</p>'}</div>`;
      setText('pageStatus', `Search - ${query}`);
      document.getElementById('researchStream').textContent = results.map((result) => `${result.title}\n${result.url}\n${result.snippet}`).join('\n\n');
    }

    function openSearchResult(encodedUrl, encodedTitle) {
      const url = decodeURIComponent(encodedUrl);
      const title = decodeURIComponent(encodedTitle);
      upsertBrowserTab({ id: `page-${Date.now()}`, title, kind: 'page', url });
      if (nativeBrowserAvailable()) {
        navigateToUrl(url);
        return;
      }
      if (!currentPageId) {
        pendingNavigateUrl = url;
        newSession();
      } else {
        navigateToUrl(url);
      }
      showBrowserFrame('Browser', url, title);
    }

    async function navigateToUrl(url) {
      appendStream('researchStream', `Navigating to ${url}`);
      if (nativeBrowserAvailable()) {
        try {
          return await executeNativeBrowserAction({ type: 'navigate', url, options: { timeout: 60000 } });
        } catch (error) {
          addMessage('system', `Native navigation failed: ${error.message}`);
          return null;
        }
      }
      sendWs('page:action', { pageId: currentPageId, action: { type: 'navigate', url, options: { waitUntil: 'domcontentloaded', timeout: 60000 } } });
    }

    async function ensureBrowserPage(url) {
      if (nativeBrowserAvailable()) {
        currentSessionId = 'electron-native';
        currentPageId = currentPageId || 'active-tab';
        setText('sessionPill', 'native');
        if (url) {
          pendingResearchAfterLoad = true;
          document.getElementById('urlInput').value = url;
          await navigateToUrl(url);
        }
        return;
      }
      if (!currentSessionId || !currentPageId) {
        const session = await api('/api/sessions', {});
        currentSessionId = session.id;
        currentPageId = session.activePageId || session.pages?.[0]?.id;
        setText('sessionPill', currentSessionId.slice(0, 8));
        addMessage('system', 'Browser agent opened a session for the current workflow.');
      }
      if (!currentPageId) throw new Error('Browser session did not create an active page.');
      if (url) {
        pendingResearchAfterLoad = true;
        document.getElementById('urlInput').value = url;
        navigateToUrl(url);
      }
    }

    async function runResearchProject() {
      if (!currentSessionId || !currentPageId) {
        const build = await getActiveBuild().catch(() => null);
        if (build?.previewUrl || activeBuildId) {
          const preview = build?.previewUrl ? build : await api(`/api/builder/builds/${activeBuildId}/preview`, {}).catch(() => null);
          if (preview?.previewUrl) {
            addMessage('system', 'Browser agent is opening the generated preview so research can use real page evidence.');
            await ensureBrowserPage(preview.previewUrl);
            return false;
          }
        }
        addMessage('system', 'No active browser session yet. Open a target URL or start a preview so Nexus can research real browser evidence.');
        return false;
