    async function ensureAgentBrowserSession() {
      if (nativeBrowserAvailable()) {
        const state = await window.nexusNativeBrowser.getState();
        currentSessionId = 'electron-native';
        currentPageId = state?.tab?.id || currentPageId || 'active-tab';
        setText('sessionPill', 'native');
        return true;
      }
      if (currentSessionId && currentPageId) return true;
      const session = await api('/api/sessions', {});
      currentSessionId = session.id;
      currentPageId = session.activePageId || session.pages?.[0]?.id;
      if (!currentPageId) throw new Error('Browser session did not create an active page.');
      setText('sessionPill', currentSessionId.slice(0, 8));
      addMessage('system', 'Created browser session for agent work.');
      return true;
    }

    async function startAgentDelegation(label, agentsCsv, defaultGoal) {
      try {
        const goal = prompt(`${label} goal`, defaultGoal || `Run ${label} for the current project`);
        if (!goal) return;
        await ensureAgentBrowserSession();
        const agents = agentsCsv.split(',').map(item => item.trim()).filter(Boolean);
        addMessage('system', `Starting ${label} with ${agents.join(', ')}...`);
        const run = await api('/api/agent-runtime/delegations', { goal, agents, sessionId: currentSessionId, pageId: currentPageId });
        appendStream('qaStream', `Delegation ${run.id}: ${run.status} · ${run.result || run.error || ''}`);
        addMessage(run.status === 'failed' ? 'system' : 'assistant', `${label} finished: ${run.status}\n${run.result || run.error || ''}`);
        showAgentSwarm();
      } catch (error) {
        addMessage('system', `Agent run failed: ${error.message}`);
      }
    }

