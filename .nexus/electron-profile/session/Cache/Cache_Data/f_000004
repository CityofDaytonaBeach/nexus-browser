    async function createRuntimeSkillFromPrompt() {
      const name = prompt('Skill name');
      if (!name) return;
      const trigger = prompt('When should Nexus use it?') || name;
      const steps = (prompt('Steps separated by semicolons') || '').split(';').map(step => step.trim()).filter(Boolean);
      await api('/api/agent-runtime/skills', { name, description: trigger, trigger, steps: steps.length ? steps : [trigger] });
      addMessage('assistant', `Saved skill: ${name}`);
      showAgentSwarm();
    }

    async function saveAgentSkill(agentId) {
      const swarm = await getApi('/api/builder/agents');
      const agent = swarm.agents.find(item => item.id === agentId);
      if (!agent) return addMessage('system', `Agent not found: ${agentId}`);
      await api('/api/agent-runtime/skills', {
        name: `${agent.name} Workflow`,
        description: agent.role,
        trigger: `Use when the chat needs ${agent.name}.`,
        steps: [`Load browser/backend evidence`, `Run ${agent.name}`, `Write outputs: ${agent.outputs.join(', ')}`, 'Persist useful lessons to memory'],
      });
      addMessage('assistant', `Saved ${agent.name} as a reusable runtime skill.`);
      showAgentSwarm();
    }

    async function createRuntimeJobFromPrompt(name, agentsCsv, defaultGoal) {
      const goal = prompt(`${name} recurring goal`, defaultGoal || name);
      if (!goal) return;
      const minutes = Math.max(1, Number(prompt('Run every how many minutes?', '60') || 60));
      const agents = agentsCsv.split(',').map(item => item.trim()).filter(Boolean);
      const job = await api('/api/agent-runtime/jobs', { name, goal, intervalMs: minutes * 60000, agents });
      addMessage('assistant', `Scheduled ${job.name} every ${minutes} minutes.`);
      showAgentSwarm();
    }

