      upsertBrowserTab({ id: `staging-${report.id}`, title: 'Staging', kind: 'staging', url: report.previewUrl });
      const frames = report.devices.map(check => {
        const runtime = [...(check.consoleErrors || []), ...(check.networkErrors || [])];
