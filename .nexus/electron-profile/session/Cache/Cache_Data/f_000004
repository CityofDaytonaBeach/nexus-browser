      addMessage('system', 'Live timeline connected.');
      events.addEventListener('step', event => {
        const item = JSON.parse(event.data);
        appendStream('qaStream', `${item.label}: ${item.detail}`);
      });
      events.addEventListener('tick', event => {
        const item = JSON.parse(event.data);
        if (item.logTail) document.getElementById('taskStream').textContent = item.logTail;
        appendStream('qaStream', `Stream ${item.ticks}: ${item.status || 'running'} / ${item.previewStatus || 'preview unknown'}`);
      });
      events.addEventListener('done', event => {
        const item = JSON.parse(event.data);
        addMessage('assistant', item.message || 'Live timeline finished.');
        events.close();
      });
      events.onerror = () => {
        addMessage('system', 'Live timeline disconnected.');
        events.close();
      };
    }

