    async function sendChat() {
      const input = document.getElementById('chatInput');
      const message = input.value.trim();
      if (!message || chatRequestInProgress) return;
      input.value = '';
      addMessage('user', message);
      let pendingMessage = null;
      try {
        applyModeFromMessage(message);
        if (maybeShowChatStatus(message)) return;
        if (prepareBrowserGrounding(message)) return;
        chatRequestInProgress = true;
        setChatBusy(true);
        pendingMessage = addMessage('system', 'Nexus is working...');
        if (!csrfToken) await loadSecurityToken();
        await refreshBrowserIntelligence(true);
        await refreshBackendObserver(true);
        const result = await api('/api/builder/chat', { chatId: chatApiId(), sessionId: currentSessionId, pageId: currentPageId, activeBuildId, message, browserContext: `${lastBrowserIntelligence}\n\n${lastBackendObservation}`.trim(), mode: document.getElementById('builderMode').value, uiLook: document.getElementById('uiLook').value, ...buildBrainOptions() }, { timeoutMs: 120000 });
        pendingMessage?.remove();
        pendingMessage = null;
        if (result.chatId) {
          const currentTitle = document.getElementById('activeChatTitle')?.textContent || '';
          setActiveChat(result.chatId, currentTitle && currentTitle !== 'Nexus Chat' ? currentTitle : message, result.projectId || null);
          if (result.sessionId) currentSessionId = result.sessionId;
          if (result.pageId) currentPageId = result.pageId;
        }
        addMessage('assistant', result.response);
        if (result.actions?.length) addActionMessage(result.actions, result.source);
        if (result.build) showBuildStarted(result.build);
        if (result.update) showBuildUpdateStarted(result.update);
        broadcastChatUpdate();
        // The backend owns intent, verification and repairs. UI refreshes never launch extra work.
      } catch (error) {
        const failure = `Builder chat failed: ${error.message}`;
        if (pendingMessage) pendingMessage.textContent = failure;
        else addMessage('system', failure);
      } finally {
        chatRequestInProgress = false;
        setChatBusy(false);
      }
    }

    function maybeShowChatStatus(message) {
      const text = message.trim().toLowerCase();
      const directStatus = /^(?:show\s+(?:me\s+)?)?(?:the\s+)?(?:current\s+)?(?:status|progress|logs|research stream|task stream|qa stream|details)(?:\s+please)?[?.!]*$/.test(text);
      const questionStatus = /^(?:what(?:'s| is)|how(?:'s| is))\s+(?:the\s+)?(?:status|progress)(?:\s+(?:of|on)\s+(?:the\s+)?(?:build|project|agents?))?[?.!]*$/.test(text)
        || /^what happened[?.!]*$/.test(text);
      if (!directStatus && !questionStatus) return false;
      addMessage('assistant', chatStatusSummary());
      return true;
    }

    function chatStatusSummary() {
      const research = document.getElementById('researchStream')?.textContent.trim() || 'No research updates yet.';
      const tasks = document.getElementById('taskStream')?.textContent.trim() || 'No task updates yet.';
      const qa = document.getElementById('qaStream')?.textContent.trim() || 'No QA updates yet.';
      const recent = nexusStatusLog.slice(-8).map(item => `- ${item}`).join('\n') || '- No recent agent events.';
      return `Current Nexus status\n\nRecent agent events:\n${recent}\n\nResearch:\n${research}\n\nTasks / OpenCode:\n${tasks}\n\nQA / Browser checks:\n${qa}`;
    }

    function maybeAskBuildIntake(message) {
      const text = message.toLowerCase();
      if (!/\b(build|create|make|generate|app|website|dashboard|landing page|site)\b/.test(text)) return false;
      if (/\b(decide and build|you decide|surprise me|auto decide|agent decide)\b/.test(text)) return false;
      const hasSpecifics = /\b(page|auth|login|dashboard|database|stripe|github|supabase|mobile|style|design|api|admin|checkout|user|customer|content|blog|shop|saas|game)\b/.test(text);
      if (hasSpecifics || message.length > 90) return false;
      addMessage('assistant', `I can build that. To avoid a generic app, answer these in one message:\n\n1. Who is it for?\n2. What are the main pages or actions?\n3. What style should it feel like?\n4. Any data, login, payments, GitHub, or Supabase?\n5. Should I clone/reference a URL or invent from scratch?\n\nIf you want me to decide, say: "decide and build".`);
      return true;
    }

    function prepareBrowserGrounding(message) {
      const urlMatch = message.match(/https?:\/\/[^\s]+|[a-z0-9.-]+\.[a-z]{2,}(?:\/[^\s]*)?/i);
      const mode = document.getElementById('builderMode').value;
      const buildCapable = ['build', 'ui-builder'].includes(mode);
      const browserFirst = buildCapable && (shouldAutoBuildFromMessage(message) || /\b(clone|recreate|copy|redesign|this site|this page|current site|current page|like|based on)\b/i.test(message));
      if (urlMatch && browserFirst) {
        const url = urlMatch[0].startsWith('http') ? urlMatch[0] : `https://${urlMatch[0]}`;
        document.getElementById('urlInput').value = url;
        pendingAutoBuild = message;
        addMessage('system', `Opening ${url} first so the build is based on real browser evidence.`);
        navigate();
        return true;
      }
      if (!currentPageId && shouldWebSearch(message) && browserFirst) {
        pendingAutoBuild = message;
        addMessage('system', 'Searching first so Nexus can choose a real browser target before building. Open a result to continue.');
        runBrowserSearch(cleanSearchQuery(message));
        return true;
      }
      return false;
    }

    function sendBuilderPrompt(message) {
      document.getElementById('chatInput').value = message;
      sendChat();
    }

    async function sendLandingChat() {
      if (landingStartInProgress) return;
