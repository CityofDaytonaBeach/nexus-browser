    async function startFromLandingValue(raw, input) {
      if (!raw) return;
      const mode = document.getElementById('landingMode')?.value || 'build';
      syncBuilderMode(mode, { announce: false });
      setLandingBusy(true, mode);
      setLandingStatus(`${modePresentation[mode].label} is starting...`);
      const looksLikeUrl = /^https?:\/\//i.test(raw) || /^[a-z0-9.-]+\.[a-z]{2,}(?:\/[^\s]*)?$/i.test(raw);
      if (!looksLikeUrl) {
        document.body.classList.remove('landing-first', 'project-live');
        document.body.classList.add('chat-first');
        toggleChat(true);
        const startsFreshBuild = mode === 'build' && isProductBuildRequest(raw) && !/\b(update|change|fix|repair|continue|resume)\b/i.test(raw);
        if (startsFreshBuild) {
          activeBuildId = null;
          localStorage.removeItem('nexus-active-build-id');
        }
        setActiveChat(`chat-${Date.now()}`, raw);
        if (input) input.value = '';
        document.getElementById('chatInput').value = raw;
        setLandingStatus(`Opening ${modePresentation[mode].label}...`);
        try {
          await sendChat();
        } finally {
          setLandingBusy(false, mode);
        }
        return;
      }
      const url = raw.startsWith('http') ? raw : `https://${raw}`;
      document.getElementById('urlInput').value = url;
      if (input) input.value = '';
      try {
        if (mode === 'build') {
          const message = `Decide and build from ${url}. First open the URL, run browser research, infer the stack and project setup with smart defaults, then build with OpenCode and run live preview, staging, and visual QA.`;
          activeBuildId = null;
          localStorage.removeItem('nexus-active-build-id');
          setActiveChat(`chat-${Date.now()}`, `Build from ${new URL(url).hostname}`);
          toggleChat(true);
          enterProjectLiveMode(url, message);
          await startProjectFromUrl(url, message);
        } else {
          const prompts = {
            chat: `Explain the product and implementation patterns visible at ${url}. Answer without changing code.`,
            plan: `Create an implementation plan based on ${url}. Include product structure, stack, milestones, and QA. Do not modify code.`,
            research: `Research ${url}. Summarize its product, UX, technical patterns, and the evidence that should inform a build. Do not modify code.`,
            'ui-builder': `Analyze and visually recreate ${url}. Use browser evidence, preserve product-specific details, and verify the result responsively.`,
          };
          const message = prompts[mode] || prompts.chat;
          document.body.classList.remove('landing-first', 'project-live');
          document.body.classList.add('chat-first');
          setActiveChat(`chat-${Date.now()}`, `${modePresentation[mode].label}: ${new URL(url).hostname}`);
          toggleChat(true);
          addMessage('system', `Opening ${url} for ${modePresentation[mode].label.toLowerCase()} mode...`);
          await openUrlInBrowser(url);
          document.getElementById('chatInput').value = message;
          await sendChat();
        }
      } catch (error) {
        addMessage('system', `${modePresentation[mode].label} start failed: ${error.message}`);
      } finally {
        setLandingBusy(false, mode);
      }
    }

    async function openUrlInBrowser(url) {
      if (!csrfToken) await loadSecurityToken();
      if (nativeBrowserAvailable()) {
        currentSessionId = 'electron-native';
        currentPageId = currentPageId || 'active-tab';
        setText('sessionPill', 'native');
        setLaunchStatus(`Opening ${url} in the native Chromium tab...`);
        const result = await executeNativeBrowserAction({ type: 'navigate', url, options: { timeout: 60000 } });
        return result?.page;
      }
      if (!currentSessionId || !currentPageId) {
        setLaunchStatus('Creating browser session...');
        addMessage('system', 'Creating browser session...');
        const session = await api('/api/sessions', {});
        currentSessionId = session.id;
        currentPageId = session.activePageId || session.pages?.[0]?.id;
        setText('sessionPill', currentSessionId.slice(0, 8));
      }
      if (!currentPageId) throw new Error('Browser session did not create an active page.');
      setLaunchStatus(`Opening ${url} in the live browser...`);
      const result = await api(`/api/sessions/${currentSessionId}/pages/${currentPageId}/action`, {
        type: 'navigate',
        url,
        options: { waitUntil: 'domcontentloaded', timeout: 60000 },
      });
      if (result?.page) updatePage(result.page);
      return result?.page;
    }

    async function startProjectFromUrl(url, message) {
      addMessage('system', `Opening ${url} in the live browser...`);
      await openUrlInBrowser(url);
      setLaunchStatus('URL loaded. Starting chat-to-OpenCode build handoff...');
      addMessage('system', 'URL loaded. Starting chat-to-OpenCode build handoff...');
      await continueBuildFromLoadedPage(message);
    }

    function applyModeFromMessage(message) {
      const text = message.toLowerCase();
      let nextMode = '';
      if (/\bresearch\s+mode\b|\bswitch\s+to\s+research\b/.test(text)) nextMode = 'research';
      else if (/\bplan\s+mode\b|\bswitch\s+to\s+plan\b/.test(text)) nextMode = 'plan';
      else if (/\bask\s+mode\b|\bswitch\s+to\s+ask\b/.test(text)) nextMode = 'chat';
      else if (/\bvisual(?:\s+edit|\s+mode)?\b|\bswitch\s+to\s+visual\b/.test(text)) nextMode = 'ui-builder';
      else if (/\bbuild\s+mode\b|\bagent\s+mode\b|\bswitch\s+to\s+(?:build|agent)\b/.test(text)) nextMode = 'build';
      if (nextMode) syncBuilderMode(nextMode);
    }

    function isProductBuildRequest(message) {
      const text = message.trim().toLowerCase();
      if (!text || text.length > 240 || /\?$/.test(text)) return false;
      if (/^(what|why|how|when|where|who|can|could|would|should|explain|tell me|show me)\b/.test(text)) return false;
      if (/\b(status|progress|logs?|staging studio|build doctor|auto heal|expert router|project memory)\b/.test(text)) return false;
      const product = /\b(landing page|website|web app|application|app|dashboard|portal|tracker|storefront|portfolio|blog|game|tool|site|ui)\b/.test(text);
      return product || /\b(build|create|make|generate|code|implement)\b/.test(text) && /\b(page|component|frontend|backend|api)\b/.test(text);
    }

    function isConversationalBuildQuestion(message) {
      const text = message.trim().toLowerCase();
      if (!text) return false;
      const politeAction = /^(?:can|could|would|will)\s+(?:you|we|nexus)\s+(?:please\s+)?(?:build|create|make|generate|implement|change|update|edit|modify|fix|improve|add|remove|replace|move|resize|restyle|connect|wire|debug|repair)\b/.test(text);
      if (politeAction) return false;
      return /^(?:what|why|how|when|where|who|which|does|do|did|is|are|was|were|has|have|can|could|would|should|will)\b/.test(text)
        || /\?\s*$/.test(text);
    }

    function shouldAutoBuildFromMessage(message) {
      if (isConversationalBuildQuestion(message)) return false;
      const mode = document.getElementById('builderMode').value;
      if (!['build', 'ui-builder'].includes(mode)) return false;
      return mode === 'build' || isProductBuildRequest(message) || /\b(build|clone|research project|start building|app brain|full app)\b/i.test(message);
    }

    function executeChatIntent(message) {
      const mode = document.getElementById('builderMode').value;
      const text = message.toLowerCase();
      if (isConversationalBuildQuestion(message)) return;
      if (mode === 'chat') return;
      if (mode === 'research') {
        if (currentPageId) {
          addMessage('system', 'Compiling research artifacts from the active page...');
          setTimeout(() => runResearchProject().catch(error => addMessage('system', `Research failed: ${error.message}`)), 900);
        }
        return;
      }
      if (mode === 'plan') {
        if (currentPageId) {
          addMessage('system', 'Generating plan artifacts from the active page...');
          setTimeout(() => runResearchProject().catch(error => addMessage('system', `Plan generation failed: ${error.message}`)), 900);
        }
        return;
      }
      const buildCommand = /\b(staging studio|multi-device preview|device wall|preview wall|staging preview|expert router|route experts|smart agents|creative mind|creative direction|visual dna|anti-template|project memory|memory|auto heal loop|heal loop|build doctor|doctor|auto heal|self heal|stack experts|all experts|official source agents|official-source agents|[a-z0-9-]+ expert)\b/.test(text);
      if (!currentPageId && !buildCommand && !message.match(/https?:\/\/[^\s]+|[a-z0-9.-]+\.[a-z]{2,}(?:\/[^\s]*)?/i) && !isProductBuildRequest(message)) {
        if (mode === 'build' || mode === 'plan') addMessage('system', 'Give me a target URL first, or switch to research mode so I can search the web for one.');
        return;
      }
      if (/\b(staging studio|multi-device preview|device wall|preview wall|staging preview)\b/.test(text)) {
        setTimeout(() => runStagingStudio(), 600);
      } else if (/\b(expert router|route experts|smart agents)\b/.test(text)) {
        setTimeout(() => runExpertRouter(), 600);
      } else if (/\b(creative mind|creative direction|visual dna|anti-template|make it not look the same)\b/.test(text)) {
        setTimeout(() => createCreativeDirection(), 600);
      } else if (/\b(project memory|memory)\b/.test(text)) {
        setTimeout(() => showProjectMemory(), 600);
      } else if (/\b(auto heal loop|heal loop|repair loop|self healing loop)\b/.test(text)) {
        setTimeout(() => runAutoHealLoop(), 800);
      } else if (/\b(stack experts|all experts|official source agents|official-source agents)\b/.test(text)) {
        setTimeout(() => showAllLanguageExperts(), 600);
      } else if (/\b(typescript expert|typescript agent|ts expert|compiler expert)\b/.test(text)) {
        setTimeout(() => showLanguageExpert('typescript'), 600);
      } else if (/\b([a-z0-9-]+)\s+expert\b/.test(text)) {
        const match = text.match(/\b([a-z0-9-]+)\s+expert\b/);
        setTimeout(() => showLanguageExpert(match[1]), 600);
      } else if (/\b(build doctor|doctor|auto heal|self heal|fix setup|dev setup|repair build)\b/.test(text)) {
        setTimeout(() => runBuildDoctor(/\b(auto heal|self heal|fix|repair)\b/.test(text)), 800);
      } else if (mode === 'build' || /\b(start building|build app|build mode|full app|research project)\b/.test(text)) {
        addMessage('system', 'Starting research-project compiler for OpenCode build...');
        setTimeout(() => runResearchProject().then((ok) => { if (ok) openIDE(); }).catch(error => addMessage('system', `Build start failed: ${error.message}`)), 1200);
      } else if (/\b(visual qa|repair qa|auto repair|compare preview|qa repair)\b/.test(text)) {
        setTimeout(() => runVisualQaRepair(), 800);
      } else if (/\b(api|mcp|sdk|endpoint)\b/.test(text)) {
        setTimeout(() => runApiCrawl().catch(error => addMessage('system', `API crawl failed: ${error.message}`)), 1200);
      } else if (/\b(bolt|palot|lovable|codex|better than|competitive)\b/.test(text)) {
        setTimeout(() => showCompetitiveBlueprint(), 600);
      } else if (/\b(hermes|agent swarm|agents|skills|memory|automations)\b/.test(text)) {
        setTimeout(() => showAgentSwarm(), 600);
      } else if (/\b(ui|tailwind|figma|overlay|component|clone)\b/.test(text)) {
        setTimeout(() => runUiIntelligence().then(() => runBuildOverlay()).catch(error => addMessage('system', `UI build failed: ${error.message}`)), 1200);
      }
    }

    function showBuildStarted(build) {
      document.body.classList.remove('landing-first', 'chat-first');
      document.body.classList.add('project-live');
      document.getElementById('chatPanel').classList.add('open');
      activeBuildId = build.id;
      localStorage.setItem('nexus-active-build-id', build.id);
      document.getElementById('outputPath').textContent = build.root;
      const agents = [...(build.stackPlan?.projectAgentIds || []), ...(build.stackPlan?.expertIds || [])].map(agentDisplayName);
      document.getElementById('taskStream').textContent = `Nexus build workspace\n\n${build.root}\n\nStack: ${build.stackPlan?.framework || 'auto-detected'} / ${build.stackPlan?.primaryLanguage || 'project language'}\n\nActive team:\n${agents.map((agent) => `- ${agent}`).join('\n') || '- Build agent, Build Doctor, and Browser QA'}`;
      document.getElementById('qaStream').textContent = 'Implementation is running. Build checks, preview, responsive browser QA, and staging follow automatically.';
      setLaunchStatus(`Nexus agents are building the requested product.\n${build.root}\n\nProgress and failures are shown directly in chat.`);
      monitorBuildProgress(build.id);
    }

    async function startPreviewThenStage() {
      await startActiveBuildPreview();
      setTimeout(() => runStagingStudio().catch((error) => {
        setLaunchStatus(`Staging is waiting for the preview server. Retrying...\n${error.message}`);
        setTimeout(() => runStagingStudio().catch((retryError) => setLaunchStatus(`Staging could not start yet. Use chat: run staging studio.\n${retryError.message}`)), 10000);
      }), 8000);
    }

    function showBuildUpdateStarted(update) {
      activeBuildId = update.buildId;
      localStorage.setItem('nexus-active-build-id', update.buildId);
      document.getElementById('outputPath').textContent = update.workspace;
      const state = update.status === 'queued' ? 'queued behind the active build' : 'started';
      document.getElementById('taskStream').textContent = `Nexus app update ${state}\n\nRequest:\n${update.userMessage}\n\nWorkspace:\n${update.workspace}`;
      document.getElementById('qaStream').textContent = `The agent team is applying the update. Preview and browser QA will refresh after queued work finishes.`;
      monitorBuildProgress(update.buildId, update.id);
    }

    function monitorBuildProgress(buildId, updateId = '', existingCard = null) {
      if (buildProgressTimer) clearTimeout(buildProgressTimer);
      let attempts = 0;
      const progressMessage = existingCard || createBuildProgressMessage(buildId, Boolean(updateId));
      const poll = async () => {
        if (activeBuildId !== buildId) return;
        attempts += 1;
        try {
          const suffix = updateId ? `?updateId=${encodeURIComponent(updateId)}` : '';
          const activity = await getApi(`/api/builder/builds/${buildId}/activity${suffix}`);
          const label = activity.kind === 'update' ? 'App update' : 'Build';
          const tail = (activity.log || '').split('\n').slice(-45).join('\n').trim();
          document.getElementById('taskStream').textContent = `${label} ${activity.status}\n\n${tail || 'Executor is starting...'}`;
          renderBuildProgressMessage(progressMessage, activity);
          setLaunchStatus(`${activity.progress?.phase || `${label}: ${activity.status}`}\n${activity.progress?.summary || activity.build.root}`);
          if (activity.terminal) {
            buildProgressTimer = null;
            if (activity.status === 'completed') {
              addMessage('assistant', `${label} verified: build and product workflows passed on desktop and mobile.`);
              if (activity.build.previewUrl) showAppPreview(activity.build);
            } else {
              const failure = activity.progress?.failure;
              if (activity.build.verification?.issues?.length) addMessage('system', activity.build.verification.issues.join('\n'));
              document.getElementById('qaStream').textContent = `${failure?.title || `${label} did not complete`}\n\n${failure?.detail || 'The executor stopped before completion.'}\n\n${failure?.recovery || 'Run Build Doctor, then retry from the preserved workspace.'}`;
            }
            return;
          }
        } catch (error) {
          setLaunchStatus(`Waiting for build status...\n${error.message}`);
        }
        if (attempts < 900) buildProgressTimer = setTimeout(poll, 2000);
        else addMessage('system', 'Build monitoring timed out after 30 minutes. Ask for status to reconnect to the task.');
      };
      poll();
    }

    async function startActiveBuildPreview() {
      if (!activeBuildId) return addMessage('system', 'No generated build workspace yet. Ask Build Mode to create one first.');
      try {
        const build = await api(`/api/builder/builds/${activeBuildId}/preview`, {});
        showAppPreview(build);
        pollPreviewLog(build.id);
        setLaunchStatus(`Live preview starting: ${build.previewUrl}`);
        addMessage('assistant', `Live preview starting: ${build.previewUrl}`);
      } catch (error) {
        setLaunchStatus(`Preview start failed: ${error.message}`);
        addMessage('system', `Preview start failed: ${error.message}`);
      }
    }

    async function verifyActiveProduct() {
      if (!activeBuildId) return;
      try { const build = await api('/api/builder/builds/' + activeBuildId + '/verify', {}); showBuildStarted(build); }
      catch (error) { addMessage('system', 'Could not start verification: ' + error.message); }
    }

    async function openActiveBuildExternal() {
      const build = await getActiveBuild();
      if (!build?.previewUrl) return addMessage('system', 'No live generated preview URL yet. Start Live App Preview first.');
      window.open(build.previewUrl, '_blank', 'noopener,noreferrer');
    }

    async function stopActiveBuildPreview() {
      if (!activeBuildId) return;
      try {
        const build = await deleteApi(`/api/builder/builds/${activeBuildId}/preview`);
        if (previewLogTimer) clearInterval(previewLogTimer);
        appendStream('qaStream', `Preview stopped for ${build.name}.`);
      } catch (error) {
        addMessage('system', `Preview stop failed: ${error.message}`);
      }
    }

    function showAppPreview(build) {
      upsertBrowserTab({ id: `preview-${build.id}`, title: build.name || 'Preview', kind: 'preview', url: build.previewUrl || '' });
      document.getElementById('browserView').innerHTML = `
        <div class="hud"><span class="pill">Live App</span><span class="pill">${build.previewStatus}</span><span class="pill">${build.previewUrl || 'starting'}</span></div>
        <div class="preview-actions"><button class="btn primary" onclick="openActiveBuildExternal()">Open App</button><button class="btn" onclick="startActiveBuildPreview()">Restart</button><button class="btn amber" onclick="stopActiveBuildPreview()">Stop</button><button class="btn" onclick="createRollbackPlan()">Restore Version</button><button class="btn" onclick="verifyActiveProduct()">Check App</button></div>
        ${build.previewUrl ? `<iframe class="app-frame" src="${build.previewUrl}" title="Generated app preview"></iframe>` : `<div class="preview-card"><div class="preview-card-inner"><h1>Preview starting</h1><p>Nexus is starting the generated app server. Staging will open here when screenshots are ready.</p></div></div>`}`;
      setText('pageStatus', `Generated app preview - ${build.previewUrl || 'starting'}`);
    }

    function pollPreviewLog(buildId) {
      if (previewLogTimer) clearInterval(previewLogTimer);
      const readLog = async () => {
        try {
          const result = await getApi(`/api/builder/builds/${buildId}/preview-log`);
          const lines = result.log.split('\n').slice(-40).join('\n');
          document.getElementById('qaStream').textContent = lines || 'Preview is starting...';
        } catch {}
      };
      readLog();
      previewLogTimer = setInterval(readLog, 2500);
    }

    function shouldWebSearch(message) {
      const mode = document.getElementById('builderMode').value;
      return mode === 'research' || /\b(search|find|research|look up|resources|examples|docs|websites)\b/i.test(message);
    }

    function cleanSearchQuery(message) {
      return message
        .replace(/\b(research|plan|build)\s+mode\b/gi, '')
        .replace(/\b(search|find|research|look up)\b/gi, '')
        .replace(/\s+/g, ' ')
        .trim() || message;
    }

    function quickStart(message) {
      const input = document.getElementById('landingChatInput');
      if (input) input.value = message;
      sendLandingChat();
    }

    function smartCommand(kind) {
      const prompts = {
        diagnose: 'Act as the senior DevTools debugger. Use the Gatherer Agent and Backend Observer context to diagnose what is rendered, what APIs are called, what console/network errors exist, what libraries are used, and what code should change first.',
        mobile: 'Run mobile and kiosk QA thinking. Check desktop, tablet, mobile touch, fullscreen kiosk, app-store screenshot, accessibility, responsive overflow, touch targets, and visual regression risks for this app.',
        backend: 'Map the backend and API functionality. Identify package scripts, dependencies, server routes, data models, env keys, auth/session behavior, API request shapes, storage, logs, and what must be duplicated.',
        employee: 'Use the Twin-inspired developer employee model. Assign Browser Gatherer, Backend Observer, Full-Stack Architect, OpenCode Implementer, Mobile/Kiosk QA, Integration Builder, and Release Operator to this project with triggers and outputs.',
        agentBrowser: '/agent-browser chat "inspect the current page, summarize what is interactive, and suggest the next browser action"',
        setup: 'Plan smart project setup before building. Infer the project type and stack, ask only missing critical questions, then connect chat, project setup, staging, Build Doctor, Agent Browser, Backend Observer, OpenCode, QA, and deploy into one workflow.',
      };
      document.getElementById('chatInput').value = prompts[kind] || prompts.diagnose;
      toggleChat(true);
      sendChat();
    }

    function updatePage(page) {
      setText('pageStatus', `${page.title || 'Page'} - ${page.url}`);
      document.getElementById('urlInput').value = page.url;
      refreshScreenshot();
      refreshBrowserIntelligence(true);
    }

    async function refreshBrowserIntelligence(silent = false) {
      if (!currentSessionId || !currentPageId) return;
      try {
        const result = await api('/api/builder/browser-intelligence', { sessionId: currentSessionId, pageId: currentPageId });
        lastBrowserIntelligence = result.context || '';
        lastGathererObservationCount = result.timeline?.length || lastGathererObservationCount;
        const gathererStatus = document.getElementById('gathererStatus');
        if (gathererStatus) gathererStatus.textContent = `${lastGathererObservationCount} observations`;
        setText('pageStatus', `Gatherer Agent: ${lastGathererObservationCount} observations - ${document.getElementById('urlInput').value || 'active page'}`);
        if (!silent) appendStream('researchStream', `Gatherer Agent refreshed (${lastGathererObservationCount} observations, ${lastBrowserIntelligence.length} chars).`);
      } catch (error) {
        if (!silent) addMessage('system', `Browser intelligence failed: ${error.message}`);
      }
    }

    async function refreshBackendObserver(silent = false) {
      if (!activeBuildId) return;
      try {
        const result = await api('/api/builder/backend-observer', { buildId: activeBuildId });
        lastBackendObservation = result.context || '';
        lastBackendObservationCount = result.timeline?.length || lastBackendObservationCount;
        const backendStatus = document.getElementById('backendStatus');
        if (backendStatus) backendStatus.textContent = `${lastBackendObservationCount} observations`;
        if (!silent) appendStream('researchStream', `Backend Observer refreshed (${lastBackendObservationCount} observations, ${lastBackendObservation.length} chars).`);
      } catch (error) {
        if (!silent) addMessage('system', `Backend Observer failed: ${error.message}`);
      }
    }

    function startBrowserIntelligenceLoop() {
      if (browserIntelTimer) clearInterval(browserIntelTimer);
      browserIntelTimer = setInterval(() => {
        refreshBrowserIntelligence(true);
        refreshBackendObserver(true);
      }, 10000);
    }

    function refreshScreenshot() {
      if (!currentPageId) return;
      if (nativeBrowserAvailable()) {
        executeNativeBrowserAction({ type: 'screenshot' }, { announce: false }).catch(() => {});
        return;
      }
      sendWs('page:screenshot', { pageId: currentPageId });
    }

    function showScreenshot(base64) {
      lastScreenshot = base64;
      document.getElementById('browserView').innerHTML = `<div class="hud"><span class="pill">${viewMode}</span><span class="pill">${document.getElementById('uiLook').value}</span></div><img id="previewImage" src="data:image/png;base64,${base64}" alt="Live browser screenshot"><div class="overlay-layer" id="overlayLayer"></div>`;
    }

    function animateBuildOverlay(plan) {
      if (overlayTimer) clearInterval(overlayTimer);
      if (!lastScreenshot) refreshScreenshot();
      const view = document.getElementById('browserView');
      if (!document.getElementById('overlayLayer')) {
        view.insertAdjacentHTML('beforeend', '<div class="overlay-layer" id="overlayLayer"></div>');
      }
      const layer = document.getElementById('overlayLayer');
      layer.innerHTML = '';
      const scale = getOverlayScale(plan);
      let index = 0;
      document.getElementById('qaStream').textContent = 'AI visual build started...';
      overlayTimer = setInterval(() => {
        if (index >= plan.blocks.length) {
          clearInterval(overlayTimer);
          appendStream('qaStream', 'AI visual build overlay complete.');
          addMessage('assistant', 'Overlay complete. OpenCode now has the ordered component build script.');
          return;
        }
        const block = plan.blocks[index];
        const el = document.createElement('div');
        el.className = 'build-block live';
        el.style.left = `${block.rect.x * scale.x + scale.offsetX}px`;
        el.style.top = `${block.rect.y * scale.y + scale.offsetY}px`;
        el.style.width = `${Math.max(10, block.rect.width * scale.x)}px`;
        el.style.height = `${Math.max(10, block.rect.height * scale.y)}px`;
        el.innerHTML = `<div class="block-label">${block.order}. ${block.kind} - ${block.name}</div>`;
        layer.appendChild(el);
        appendStream('taskStream', `${block.order}. ${block.name}\n${block.tailwind}`);
        appendStream('qaStream', block.explanation);
        setTimeout(() => el.classList.add('done'), 550);
        index += 1;
      }, 420);
    }

    function getOverlayScale(plan) {
      const view = document.getElementById('browserView');
      const img = document.getElementById('previewImage');
      const viewport = plan.viewport || { width: img?.naturalWidth || view.clientWidth, height: img?.naturalHeight || view.clientHeight };
      const containerRatio = view.clientWidth / view.clientHeight;
      const sourceRatio = viewport.width / viewport.height;
      let width = view.clientWidth;
      let height = view.clientHeight;
      let offsetX = 0;
      let offsetY = 0;
      if (sourceRatio > containerRatio) {
        height = width / sourceRatio;
        offsetY = (view.clientHeight - height) / 2;
      } else {
        width = height * sourceRatio;
        offsetX = (view.clientWidth - width) / 2;
      }
      return { x: width / viewport.width, y: height / viewport.height, offsetX, offsetY };
    }

    function setViewMode(el, mode) {
      viewMode = mode;
      document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
      el.classList.add('active');
      setText('viewPill', mode);
      appendStream('qaStream', `Switched to ${mode} mode.`);
    }

    function updateMetrics(project) {
      document.getElementById('endpointCount').textContent = project.brain.api.endpoints.length;
      document.getElementById('componentCount').textContent = project.brain.ui.components.length;
      document.getElementById('pageCount').textContent = project.brain.pages.length;
      document.getElementById('outputCount').textContent = Object.keys(project.tasks).length + Object.keys(project.integrations).length;
    }

    function addMessage(role, content) {
      const messages = document.getElementById('messages');
      const div = document.createElement('div');
      div.className = `msg ${role}`;
      div.textContent = content;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
      return div;
    }

    function createBuildProgressMessage(buildId, isUpdate = false) {
      const messages = document.getElementById('messages');
      const div = document.createElement('div');
      div.className = 'msg assistant build-progress';
      div.dataset.buildId = buildId;
      div.innerHTML = `<div class="build-progress-head"><strong>${isUpdate ? 'Nexus app update' : 'Nexus multi-agent build'}</strong><span class="build-progress-state">starting</span></div><div class="build-progress-summary">Loading the agent route and build stages...</div><div class="build-progress-track"><span></span></div>`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
      return div;
    }

    function agentDisplayName(value) {
      const known = {
        'framework-expert-router': 'Framework router',
        'opencode-build-agent': 'Build agent',
        'build-doctor-agent': 'Build Doctor',
        'qa-agent': 'Browser QA',
        'memory-agent': 'Project memory',
        'react-agent': 'React agent',
      };
      return known[value] || String(value || '').replace(/-agent$/, '').replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase());
    }

    function renderBuildProgressMessage(card, activity) {
      const progress = activity.progress || {};
      const failed = Boolean(progress.failure) || ['failed', 'opencode-unavailable'].includes(activity.status);
      const completed = activity.status === 'completed' && !activity.pendingUpdates;
      const state = failed ? 'failed' : completed ? 'completed' : activity.status === 'queued' ? 'queued' : 'running';
      card.dataset.state = state;
      const steps = (progress.steps || []).map((step) => `<div class="build-step ${escapeHtml(step.status)}"><span class="build-step-dot"></span><span><b>${escapeHtml(step.label)}</b><small>${escapeHtml(step.detail)}</small></span></div>`).join('');
      const agents = (progress.agents || []).map((agent) => `<span class="build-agent">${escapeHtml(agentDisplayName(agent))}</span>`).join('');
      const output = (progress.recentOutput || [])
        .filter((line) => !(completed && /Code executor exited with code/i.test(line)))
        .filter((line) => !(completed && (/^# Todos$/i.test(line) || /^\[[\u2713\u2022 x]\]/i.test(line))))
        .join('\n');
      const failure = progress.failure ? `<div class="build-failure"><b>${escapeHtml(progress.failure.title)}</b><span>${escapeHtml(progress.failure.detail)}</span><span>${escapeHtml(progress.failure.recovery)}</span></div>` : '';
      const actions = failed ? `<div class="build-progress-actions"><button type="button" onclick="retryBuildFromProgress('${escapeJs(activity.build.id)}')">Retry build</button><button type="button" onclick="runBuildDoctor(true)">Run Build Doctor</button></div>` : '';
      card.innerHTML = `
        <div class="build-progress-head"><strong>${activity.kind === 'update' ? 'Nexus app update' : 'Nexus multi-agent build'}</strong><span class="build-progress-state">${escapeHtml(progress.phase || activity.status)}</span></div>
        <div class="build-progress-summary">${escapeHtml(progress.summary || 'Nexus is preparing the workspace.')}</div>
        <div class="build-progress-track"><span style="width:${Math.max(0, Math.min(100, Number(progress.percent || 0)))}%"></span></div>
        <div class="build-progress-steps">${steps}</div>
        ${agents ? `<div class="build-agent-list">${agents}</div>` : ''}
        ${output ? `<pre class="build-output">${escapeHtml(output)}</pre>` : ''}
        ${failure}
        ${actions}`;
      const messages = document.getElementById('messages');
      messages.scrollTop = messages.scrollHeight;
    }

    function retryBuildFromProgress(buildId) {
      activeBuildId = buildId;
      localStorage.setItem('nexus-active-build-id', buildId);
      syncBuilderMode('build');
      document.getElementById('chatInput').value = 'Fix the failed build, continue implementation from the preserved workspace, run the build checks, then start the preview and browser QA.';
      sendChat();
    }

    function setChatBusy(busy) {
      const input = document.getElementById('chatInput');
      const button = document.getElementById('chatSendButton');
      if (input) input.disabled = busy;
      if (button) {
        button.disabled = busy;
        button.textContent = busy ? 'Working...' : 'Send';
      }
      if (!busy && document.body.classList.contains('chat-first')) input?.focus();
    }

    function addActionMessage(actions, source) {
      if (!actions.length) return;
      const messages = document.getElementById('messages');
      const wrap = document.createElement('div');
      wrap.className = 'chat-actions';
      const sourceLine = document.createElement('div');
      sourceLine.className = 'chat-source';
      sourceLine.textContent = source === 'agent-browser' ? 'Agent Browser next moves' : source === 'ai' ? 'AI conductor next moves' : 'Fallback next moves';
      wrap.appendChild(sourceLine);
      actions.slice(0, 2).forEach((action) => {
        const button = document.createElement('button');
        button.className = 'chat-action';
        button.type = 'button';
        const title = document.createElement('b');
        title.textContent = action.label || 'Run';
        const desc = document.createElement('span');
        desc.textContent = action.description || action.prompt || '';
        button.appendChild(title);
        button.appendChild(desc);
        button.onclick = () => sendBuilderPrompt(action.prompt || action.description || action.label || 'Continue');
        wrap.appendChild(button);
      });
      messages.appendChild(wrap);
      messages.scrollTop = messages.scrollHeight;
    }

    function appendStream(id, text) {
      const el = document.getElementById(id);
      el.textContent = `${el.textContent}\n${new Date().toLocaleTimeString()} ${text}`.trim();
      nexusStatusLog.push(`${id}: ${text}`);
      if (nexusStatusLog.length > 100) nexusStatusLog.shift();
    }

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    }

    function escapeJs(value) {
      return String(value || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;').replace(/\r?\n/g, '\\n');
    }

    function setStatus(ok, text) {
      setText('statusText', text);
      const apiDot = document.getElementById('apiDot');
      if (apiDot) apiDot.className = ok ? 'dot' : 'dot bad';
      const wsBadge = document.getElementById('wsBadge');
      if (wsBadge) wsBadge.innerHTML = `<span class="dot ${ok ? '' : 'bad'}"></span>${ok ? 'live' : 'offline'}`;
    }

    async function detectWebGpu() {
      const supported = Boolean(navigator.gpu);
      const badge = document.getElementById('gpuBadge');
      if (badge) badge.textContent = supported ? 'GPU' : 'CPU';
      appendStream('qaStream', supported ? 'WebGPU available for future visual analysis acceleration.' : 'WebGPU not available; CPU/browser mode active.');
    }

    function openIDE() {
      const url = `http://${location.hostname === 'localhost' ? '127.0.0.1' : location.hostname}:3002`;
      upsertBrowserTab({ id: 'ide', title: 'IDE', kind: 'ide', url });
      showBrowserFrame('IDE', url, 'Files and terminal');
    }

    document.getElementById('urlInput').addEventListener('keydown', (event) => { if (event.key === 'Enter') navigate(); });
    document.getElementById('landingForm')?.addEventListener('submit', (event) => { event.preventDefault(); sendLandingChat(); });
    document.getElementById('uiLook').addEventListener('change', (event) => { setText('lookPill', event.target.value); });
    const savedBuilderMode = localStorage.getItem('nexus-builder-mode');
    const initialBuilderMode = savedBuilderMode && modePresentation[savedBuilderMode] ? savedBuilderMode : 'build';
    syncBuilderMode(initialBuilderMode, { persist: false, announce: false });
    document.getElementById('landingMode').addEventListener('change', (event) => syncBuilderMode(event.target.value));
    document.getElementById('builderMode').addEventListener('change', (event) => {
      syncBuilderMode(event.target.value);
    });

    function startFromQueryParam() {
      const raw = new URLSearchParams(location.search).get('start');
      if (!raw || !document.body.classList.contains('landing-first')) return;
      const input = document.getElementById('landingChatInput');
      if (input) input.value = raw;
      history.replaceState(null, '', location.pathname + location.hash);
      setTimeout(() => startFromLandingValue(raw, input), 300);
    }

    initTheme();
    initWindowMode();
    if (activeChatId) setText('activeChatTitle', compactLabel(activeChatId, 34));
    renderBrowserTabs();
    detectWebGpu();
    loadSecurityToken().finally(async () => {
      connect();
      startBrowserIntelligenceLoop();
      if (popoutChatId || activeChatId) await openChat(popoutChatId || activeChatId, { announce: false });
      startFromQueryParam();
    });
  </script>
</body>
