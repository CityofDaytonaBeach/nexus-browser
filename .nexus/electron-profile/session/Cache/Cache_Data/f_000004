<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NexusBrowser Builder</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      color-scheme: light;
      --bg: #f6f6f4;
      --canvas: #ffffff;
      --panel: rgba(255,255,255,.86);
      --panel-2: #ffffff;
      --line: #deded8;
      --text: #171717;
      --muted: #73736d;
      --blue: #111827;
      --blue-soft: rgba(17,24,39,.07);
      --violet: #6d5efc;
      --green: #16a34a;
      --amber: #b7791f;
      --red: #dc2626;
      --shadow: 0 18px 45px rgba(0,0,0,.08);
      --preview-grid-a: #fafafa;
      --preview-grid-b: #f1f1ee;
    }
    [data-theme="dark"] {
      color-scheme: dark;
      --bg: #0f0f0f;
      --canvas: #050505;
      --panel: rgba(18,18,18,.9);
      --panel-2: #171717;
      --line: #2a2a2a;
      --text: #f5f5f0;
      --muted: #9a9a91;
      --blue: #f5f5f0;
      --blue-soft: rgba(245,245,240,.08);
      --shadow: 0 20px 70px rgba(0,0,0,.42);
      --preview-grid-a: #111;
      --preview-grid-b: #171717;
    }
    body { height: 100vh; overflow: hidden; background: var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, Segoe UI, sans-serif; }
    button, input, select, textarea { font: inherit; }
    .shell { display: grid; grid-template-rows: 48px 1fr 24px; height: 100vh; }
    .topbar { display: flex; align-items: center; gap: 8px; padding: 7px 10px; border-bottom: 1px solid var(--line); background: var(--panel); backdrop-filter: blur(18px); }
    body.chat-first { color-scheme: light; --bg: #f6f6f4; --canvas: #ffffff; --panel: rgba(255,255,255,.88); --panel-2: rgba(255,255,255,.94); --line: rgba(17,24,39,.12); --text: #171717; --muted: #73736d; --blue: #111827; --blue-soft: rgba(17,24,39,.07); --shadow: 0 28px 90px rgba(17,24,39,.12); }
    body.chat-first .topbar, body.chat-first #toolsPanel, body.chat-first .statusbar { display: none; }
    body.chat-first .shell { grid-template-rows: 1fr; }
    body.chat-first .workspace { grid-template-columns: 1fr; }
    body.chat-first .mode-tabs, body.chat-first .build-stream { display: none; }
    body.chat-first .hud { display: none; }
    body.chat-first .center { grid-template-rows: 1fr; }
    body.chat-first #chatPanel:not(.open) { display: flex; }
    body.chat-first #chatPanel.open, body.chat-first #chatPanel { inset: 50% auto auto 50%; width: min(760px, calc(100vw - 28px)); height: min(760px, calc(100vh - 28px)); border-radius: 28px; transform: translate(-50%, -50%); opacity: 1; pointer-events: auto; box-shadow: var(--shadow), 0 0 80px rgba(99,102,241,.09); }
    body.chat-first .chat-briefing, body.chat-first .chat-actions { display: none; }
    body.chat-first .panel-title { padding: 14px 16px; color: var(--muted); border-bottom-color: rgba(17,24,39,.1); }
    body.chat-first .panel-title button { display: none; }
    body.landing-first { color-scheme: light; --bg: #f6f6f4; --canvas: #ffffff; --panel: rgba(255,255,255,.88); --panel-2: rgba(255,255,255,.94); --line: rgba(17,24,39,.12); --text: #171717; --muted: #73736d; --blue: #111827; --blue-soft: rgba(17,24,39,.07); --shadow: 0 28px 90px rgba(17,24,39,.12); }
    body.landing-first .topbar, body.landing-first #toolsPanel, body.landing-first .statusbar, body.landing-first .mode-tabs, body.landing-first .build-stream, body.landing-first #chatPanel { display: none; }
    body.landing-first .shell { grid-template-rows: 1fr; }
    body.landing-first .center { grid-template-rows: 1fr; }
    body.landing-first .workspace { grid-template-columns: 1fr; }
    body.project-live { color-scheme: light; --bg: #f6f6f4; --canvas: #ffffff; --panel: rgba(255,255,255,.9); --panel-2: rgba(255,255,255,.96); --line: rgba(17,24,39,.12); --text: #171717; --muted: #73736d; --blue: #111827; --blue-soft: rgba(17,24,39,.07); --shadow: 0 24px 70px rgba(17,24,39,.12); }
    body.project-live .topbar, body.project-live #toolsPanel, body.project-live .statusbar, body.project-live .mode-tabs, body.project-live .build-stream { display: none; }
    body.project-live .shell { grid-template-rows: 1fr; }
    body.project-live .center { grid-template-rows: 1fr; }
    body.project-live .workspace { grid-template-columns: 1fr; }
    body.project-live #chatPanel { right: 18px; bottom: 18px; top: auto; left: auto; width: min(430px, calc(100vw - 28px)); height: min(640px, calc(100vh - 36px)); border-radius: 24px; transform: none; opacity: 1; pointer-events: auto; box-shadow: var(--shadow); }
    body.project-live .chat-briefing, body.project-live .chat-actions { display: none; }
    body.project-live .panel-title button { display: none; }
    .brand { width: 132px; font-size: 12px; font-weight: 760; letter-spacing: .08em; color: var(--text); }
    .browser-tabs { display: flex; align-items: center; gap: 6px; max-width: 34vw; overflow: auto; }
    .browser-tab { display: inline-flex; align-items: center; gap: 6px; max-width: 180px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--muted); padding: 6px 10px; font-size: 12px; cursor: pointer; white-space: nowrap; }
    .browser-tab.active { background: var(--panel-2); color: var(--text); border-color: var(--text); }
    .browser-tab span { overflow: hidden; text-overflow: ellipsis; }
    .url { flex: 1; display: flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: var(--panel-2); border-radius: 12px; padding: 4px 6px; box-shadow: inset 0 1px 0 rgba(255,255,255,.05); }
    .url input { flex: 1; border: 0; outline: 0; color: var(--text); background: transparent; }
    .btn { border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 10px; padding: 6px 9px; cursor: pointer; transition: .14s ease; font-size: 12px; white-space: nowrap; }
    .btn:hover { border-color: var(--text); background: var(--blue-soft); }
    .btn.primary { border-color: var(--text); background: var(--text); color: var(--bg); font-weight: 760; }
    .btn.green { border-color: rgba(34,197,94,.55); color: var(--green); }
    .btn.amber { border-color: rgba(245,158,11,.55); color: var(--amber); }
    .workspace { position: relative; display: grid; grid-template-columns: 1fr; min-height: 0; overflow: hidden; }
    .panel { position: absolute; top: 10px; bottom: 10px; left: 10px; z-index: 20; width: 260px; min-height: 0; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); backdrop-filter: blur(18px); box-shadow: var(--shadow); transform: translateX(calc(-100% - 18px)); opacity: 0; pointer-events: none; transition: .16s ease; }
    .panel.open { transform: translateX(0); opacity: 1; pointer-events: auto; }
    .panel.right { left: auto; right: 12px; top: auto; bottom: 34px; width: min(420px, calc(100vw - 24px)); height: min(640px, calc(100vh - 96px)); border: 1px solid var(--line); transform: translateY(16px) scale(.98); transform-origin: bottom right; }
    .panel.right.open { transform: translateY(0) scale(1); }
    body.chat-popout .shell { display: block; height: 100vh; }
    body.chat-popout .topbar, body.chat-popout .center, body.chat-popout .statusbar, body.chat-popout #toolsPanel { display: none; }
    body.chat-popout .workspace { height: 100vh; display: block; }
    body.chat-popout #chatPanel { inset: 0; width: 100vw; height: 100vh; display: flex; border: 0; border-radius: 0; transform: none; opacity: 1; pointer-events: auto; }
    .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
    .section { padding: 8px; border-bottom: 1px solid var(--line); }
    .label { margin-bottom: 5px; color: var(--muted); font-size: 11px; }
    .select, .input { width: 100%; border: 1px solid var(--line); background: var(--panel-2); color: var(--text); border-radius: 10px; padding: 7px 8px; outline: none; font-size: 12px; }
    .tools { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; overflow: auto; }
    .tool { min-height: 36px; display: flex; align-items: center; padding: 8px 9px; border: 1px solid var(--line); border-radius: 11px; background: transparent; cursor: pointer; }
    .tool:hover { border-color: var(--text); background: var(--blue-soft); }
    .tool strong { font-size: 12px; font-weight: 650; }
    .tool span { display: none; }
    .center { min-width: 0; min-height: 0; display: grid; grid-template-rows: 40px 1fr 104px; background: var(--canvas); }
    .mode-tabs { display: flex; gap: 6px; align-items: center; padding: 6px 8px; border-bottom: 1px solid var(--line); background: var(--panel); backdrop-filter: blur(18px); }
    .tab { border: 1px solid transparent; color: var(--muted); border-radius: 999px; padding: 6px 10px; font-size: 12px; cursor: pointer; }
    .tab.active { color: var(--text); border-color: var(--line); background: var(--panel-2); }
    .preview { position: relative; min-height: 0; overflow: hidden; background: radial-gradient(circle at 20% 15%, rgba(109,94,252,.16), transparent 28%), radial-gradient(circle at 82% 28%, rgba(34,211,238,.18), transparent 30%), linear-gradient(180deg,#fbfbfa,#f6f6f4 58%,#ededeb); }
    body.chat-first .preview::before, body.landing-first .preview::before, body.project-live .preview::before { content: '010101  NEXUS  BUILD  ROUTE  AGENT  STAGE  VERIFY  SHIP\A function build(){ return evidence.map(code).test(); }\A 101101  BROWSER  DOM  NETWORK  API  QA  MOBILE  DEPLOY\A const agents = [gatherer, browser, backend, opencode, staging];\A 011010  SNAPSHOT  REACT  VITALS  MCP  SUPABASE  STRIPE\A while(goal){ research(); implement(); preview(); heal(); }\A 110011  TYPESCRIPT  TAILWIND  NODE  GITHUB  VERCEL\A export default async function awesome(){ await nexus.run(); }'; position: absolute; inset: -40% -10% 0; z-index: 0; white-space: pre; color: rgba(17,24,39,.08); font: 700 18px/1.8 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: .18em; transform: rotate(-8deg); animation: matrixRain 18s linear infinite; pointer-events: none; }
    body.chat-first .preview::after, body.landing-first .preview::after, body.project-live .preview::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, transparent 0 48%, rgba(109,94,252,.08) 49%, transparent 51% 100%), radial-gradient(circle at 50% 52%, rgba(34,211,238,.12), transparent 24%), repeating-linear-gradient(180deg, rgba(17,24,39,.025) 0 1px, transparent 1px 5px); animation: codePulse 5s ease-in-out infinite; }
    .preview img { width: 100%; height: 100%; object-fit: contain; display: block; }
    .app-frame { width: 100%; height: 100%; border: 0; background: white; display: block; }
    .search-page { position: relative; z-index: 2; height: 100%; overflow: auto; padding: 72px min(7vw,72px) 40px; color: var(--text); }
    .search-page h1 { font-size: clamp(26px,4vw,52px); letter-spacing: -.06em; margin-bottom: 18px; }
    .search-result { display: grid; gap: 7px; border: 1px solid rgba(17,24,39,.12); border-radius: 18px; background: rgba(255,255,255,.78); padding: 16px; margin-bottom: 10px; cursor: pointer; backdrop-filter: blur(20px); box-shadow: 0 16px 50px rgba(17,24,39,.08); }
    .search-result:hover { border-color: rgba(17,24,39,.42); background: rgba(255,255,255,.95); }
    .search-result b { font-size: 17px; }
    .search-result small { color: var(--muted); overflow-wrap: anywhere; }
    .search-result p { color: var(--muted); line-height: 1.45; }
    .preview-actions { position: absolute; right: 14px; top: 14px; display: flex; gap: 6px; z-index: 4; padding: 4px; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb,var(--panel),transparent 8%); backdrop-filter: blur(18px); }
    .staging-studio { height: 100%; display: grid; grid-template-columns: 220px 1fr; gap: 10px; padding: 56px 12px 12px; color: var(--text); }
    .staging-panel { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); padding: 10px; overflow: auto; box-shadow: var(--shadow); }
    .staging-score { font-size: 34px; line-height: 1; color: var(--blue); margin: 6px 0; }
    .device-wall { min-width: 0; overflow: auto; display: flex; align-items: flex-start; gap: 12px; padding-bottom: 8px; }
    .device-frame { flex: 0 0 auto; border: 1px solid var(--line); border-radius: 16px; background: #0f172a; padding: 8px; box-shadow: var(--shadow); }
    .device-frame header { color: #e2e8f0; font-size: 11px; display: flex; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
    .device-shot { width: 100%; max-height: 560px; object-fit: contain; border-radius: 10px; background: white; display: block; }
    .preview-card { height: 100%; display: grid; place-items: center; padding: 48px; }
    .preview-card-inner { width: min(720px, 92vw); border: 1px solid var(--line); border-radius: 24px; background: var(--panel); box-shadow: var(--shadow); padding: 24px; }
    .preview-card-inner h1 { font-size: clamp(28px, 5vw, 56px); letter-spacing: -.07em; margin-bottom: 10px; }
    .preview-card-inner p { color: var(--muted); line-height: 1.5; margin-bottom: 16px; }
    .live-build-card { height: 100%; display: grid; place-items: center; padding: min(9vw,96px); position: relative; z-index: 2; }
    .live-build-inner { width: min(880px, calc(100vw - 48px)); border: 1px solid rgba(17,24,39,.12); border-radius: 34px; background: rgba(255,255,255,.82); box-shadow: var(--shadow); backdrop-filter: blur(24px); padding: clamp(22px,4vw,44px); }
    .live-build-inner h1 { font-size: clamp(34px,7vw,82px); letter-spacing: -.08em; line-height: .92; margin-bottom: 14px; }
    .live-build-inner p { color: var(--muted); font-size: clamp(14px,2vw,18px); line-height: 1.55; max-width: 680px; }
    .launch-status { margin-top: 18px; border: 1px solid rgba(17,24,39,.1); border-radius: 18px; background: rgba(255,255,255,.72); padding: 12px 14px; color: var(--text); font-size: 13px; line-height: 1.45; white-space: pre-wrap; }
    .build-pipeline { display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; margin-top: 24px; }
    .build-pipeline span { border: 1px solid rgba(17,24,39,.1); border-radius: 999px; background: rgba(255,255,255,.9); padding: 9px 10px; color: var(--muted); font-size: 12px; text-align: center; }
    .build-pipeline span:first-child { color: var(--text); border-color: rgba(17,24,39,.28); }
    .overlay-layer { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .build-block { position: absolute; border: 2px solid rgba(56,189,248,.95); background: rgba(56,189,248,.16); border-radius: 8px; box-shadow: 0 0 0 1px rgba(15,23,42,.28), 0 14px 40px rgba(56,189,248,.25); opacity: 0; transform: scale(.96); transition: opacity .22s ease, transform .22s ease; }
    .build-block.live { opacity: 1; transform: scale(1); }
    .build-block.done { border-color: rgba(34,197,94,.9); background: rgba(34,197,94,.12); box-shadow: 0 0 0 1px rgba(15,23,42,.2); }
    .block-label { position: absolute; left: 0; top: -24px; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 999px; background: rgba(3,7,18,.88); color: white; padding: 4px 8px; font-size: 11px; }
    .empty { position: relative; z-index: 2; height: 100%; display: grid; place-items: center; color: var(--text); text-align: center; padding: 30px; }
    .empty::before { content: '<Nexus />\A chat -> plan -> build -> stage -> ship'; position: absolute; top: 12%; left: 50%; transform: translateX(-50%); color: rgba(17,24,39,.16); white-space: pre; font: 700 clamp(18px,3vw,42px)/1.35 ui-monospace, SFMono-Regular, Consolas, monospace; letter-spacing: -.04em; text-shadow: 0 0 40px rgba(109,94,252,.18); animation: floatCode 6s ease-in-out infinite; }
    .empty h1 { font-size: clamp(24px, 4vw, 48px); line-height: .95; margin-bottom: 10px; }
    .landing-builder { width: min(720px, 94vw); border: 1px solid rgba(17,24,39,.12); border-radius: 24px; background: rgba(255,255,255,.82); box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.8); padding: 22px; backdrop-filter: blur(22px); color: var(--text); text-align: left; }
    .landing-minimal { width: min(760px, 100%); padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; backdrop-filter: none; }
    .landing-intro { margin: 0 auto 18px; text-align: center; }
    .landing-intro h1 { margin: 0; color: var(--text); font-size: 34px; line-height: 1; letter-spacing: 0; }
    .landing-intro p { margin: 8px 0 0; color: var(--muted); font-size: 14px; }
    .landing-builder p { color: var(--muted); margin-bottom: 14px; font-size: 14px; }
    .landing-chat { display: grid; gap: 8px; padding: 10px; border: 1px solid rgba(17,24,39,.1); border-radius: 16px; background: rgba(255,255,255,.92); }
    .landing-chat textarea { width: 100%; min-height: 88px; resize: none; border: 0; outline: 0; color: var(--text); background: transparent; font-size: 16px; line-height: 1.45; padding: 8px; font-family: inherit; }
    .landing-chat textarea::placeholder { color: color-mix(in srgb,var(--muted),transparent 14%); }
    .landing-composer-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .landing-mode { min-width: 116px; max-width: 52%; border: 1px solid var(--line); border-radius: 9px; background: var(--panel-2); color: var(--text); padding: 8px 30px 8px 10px; outline: none; font-size: 12px; font-weight: 650; cursor: pointer; }
    .landing-chat button { min-width: 88px; }
    .landing-status { min-height: 20px; margin: 10px 8px 0; color: var(--muted); font-size: 12px; }
    .landing-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .landing-chats { border: 0; background: transparent; color: var(--muted); padding: 8px; cursor: pointer; font-size: 12px; font-weight: 700; }
    .landing-chats:hover { color: var(--text); }
    .quick-prompts { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-top: 10px; }
    .quick-prompts button { border: 1px solid var(--line); border-radius: 999px; background: var(--panel-2); color: var(--text); padding: 5px 8px; cursor: pointer; font-size: 11px; }
    .quick-prompts button:hover { border-color: var(--blue); color: var(--blue); }
    .hud { position: absolute; top: 14px; left: 14px; display: flex; gap: 6px; flex-wrap: wrap; z-index: 4; }
    .pill { border: 1px solid var(--line); background: color-mix(in srgb,var(--panel),transparent 8%); color: var(--text); border-radius: 999px; padding: 6px 9px; font-size: 11px; backdrop-filter: blur(12px); }
    .build-stream { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; border-top: 1px solid var(--line); background: var(--panel); overflow: hidden; }
    .stream-card { border-right: 1px solid var(--line); background: transparent; padding: 8px; min-height: 90px; overflow: auto; }
    .stream-card:last-child { border-right: 0; }
    .stream-card h3 { font-size: 11px; margin-bottom: 5px; color: var(--muted); font-weight: 650; }
    .stream-card pre { white-space: pre-wrap; color: var(--muted); font-size: 10px; line-height: 1.35; }
    .chat { min-height: 0; display: flex; flex-direction: column; }
    .chat-briefing { border-bottom: 1px solid var(--line); padding: 10px; display: grid; gap: 8px; background: linear-gradient(180deg,var(--panel-2),transparent); }
    .agent-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .agent-chip { border: 1px solid var(--line); border-radius: 12px; padding: 7px; background: var(--panel-2); font-size: 11px; line-height: 1.25; }
    .agent-chip b { display: block; font-size: 12px; color: var(--text); }
    .agent-chip span { color: var(--muted); }
    .command-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .command-grid button { border: 1px solid var(--line); border-radius: 11px; background: transparent; color: var(--text); padding: 7px 8px; cursor: pointer; font-size: 11px; text-align: left; }
    .command-grid button:hover { border-color: var(--text); background: var(--blue-soft); }
    .messages { flex: 1; overflow: auto; padding: 18px; display: flex; flex-direction: column; gap: 10px; }
    .msg { max-width: 94%; border: 1px solid var(--line); border-radius: 16px; padding: 11px 12px; white-space: pre-wrap; font-size: 13px; line-height: 1.45; }
    .msg.user { align-self: flex-end; background: var(--text); color: var(--bg); border-color: var(--text); font-weight: 650; }
    .msg.assistant { align-self: flex-start; background: rgba(255,255,255,.9); }
    .msg.system { align-self: center; color: var(--muted); background: transparent; border: 0; font-size: 12px; }
    .msg.build-progress { width: 94%; max-width: 94%; padding: 12px; border-radius: 8px; white-space: normal; display: grid; gap: 10px; }
    .build-progress-head { display: flex; align-items: center; gap: 8px; }
    .build-progress-head strong { min-width: 0; flex: 1; font-size: 13px; }
    .build-progress-state { flex: 0 0 auto; border: 1px solid var(--line); border-radius: 999px; padding: 3px 7px; color: var(--muted); font-size: 10px; font-weight: 750; text-transform: uppercase; }
    .build-progress[data-state="failed"] .build-progress-state { border-color: rgba(239,68,68,.28); color: #b91c1c; background: rgba(254,226,226,.64); }
    .build-progress[data-state="completed"] .build-progress-state { border-color: rgba(22,163,74,.25); color: #166534; background: rgba(220,252,231,.68); }
    .build-progress-summary { color: var(--muted); font-size: 12px; line-height: 1.4; }
    .build-progress-track { height: 6px; overflow: hidden; border-radius: 999px; background: rgba(17,24,39,.09); }
    .build-progress-track span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--text); transition: width .3s ease; }
    .build-progress[data-state="failed"] .build-progress-track span { background: #dc2626; }
    .build-progress-steps { display: grid; gap: 6px; }
    .build-step { display: grid; grid-template-columns: 10px minmax(0,1fr); gap: 7px; align-items: start; }
    .build-step-dot { width: 8px; height: 8px; margin-top: 4px; border: 1px solid rgba(17,24,39,.2); border-radius: 50%; background: transparent; }
    .build-step.completed .build-step-dot { border-color: #16a34a; background: #16a34a; }
    .build-step.running .build-step-dot { border-color: var(--text); background: var(--text); box-shadow: 0 0 0 3px rgba(17,24,39,.1); }
