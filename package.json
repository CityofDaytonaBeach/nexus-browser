{
  "name": "nexus-browser",
  "version": "1.0.0",
  "description": "The First AI-Native Smart Browser - Cloud-based, AI-powered browser with built-in OpenCode IDE",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "start:cloud": "ts-node src/index.ts --cloud",
    "start:headless": "ts-node src/index.ts --headless",
    "start:dev": "ts-node-dev --respawn src/index.ts",
    "cli": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "playwright": "^1.58.2",
    "ws": "^8.18.0",
    "express": "^4.21.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "xterm": "^5.3.0",
    "sharp": "^0.33.2",
    "natural": "^8.0.1",
    "compromise": "^14.14.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "eventemitter3": "^5.0.1",
    "async-mutex": "^0.5.0",
    "zod": "^3.23.8",
    "yaml": "^2.4.5",
    "glob": "^11.0.0",
    "chokidar": "^3.6.0",
    "electron": "^30.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.8",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/cors": "^2.8.17",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "eslint": "^9.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
