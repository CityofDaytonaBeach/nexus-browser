{
  "name": "nexus-browser",
  "version": "1.0.0",
  "description": "The First AI-Native Smart Browser - Cloud-based, AI-powered browser with built-in OpenCode IDE",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "desktop": "npm run build && node scripts/desktop.js",
    "desktop:dev": "npm run build && node scripts/desktop-dev.js",
    "package:desktop": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "start": "ts-node src/index.ts",
    "start:cloud": "ts-node src/index.ts --cloud",
    "start:headless": "ts-node src/index.ts --headless",
    "start:dev": "ts-node-dev --respawn src/index.ts",
    "cli": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "agent-browser": "^0.37.1",
    "async-mutex": "^0.5.0",
    "chalk": "^4.1.2",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "compromise": "^14.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron": "^30.0.0",
    "eventemitter3": "^5.0.1",
    "express": "^4.21.0",
    "glob": "^11.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "natural": "^8.0.1",
    "node-pty": "^1.0.0",
    "p-queue": "^8.0.1",
    "p-retry": "^6.2.0",
    "playwright": "^1.58.2",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "xterm": "^5.3.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "electron-builder": "^24.13.3",
    "eslint": "^9.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0"
  },
  "build": {
    "appId": "ai.nexus.browser",
    "productName": "NexusBrowser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/ui/electron.js"
    },
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "icon": "public/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
