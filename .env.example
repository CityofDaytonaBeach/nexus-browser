# Nexus Browser Configuration

# Server
PORT=3000
WS_PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# Authentication
JWT_SECRET=your-secret-key-change-this
API_KEY=your-api-key

# AI / LLM Configuration
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai

# Browser
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
USER_DATA_DIR=./profiles

# Cloud Mode
CLOUD_MODE=false
MAX_SESSIONS=10
MAX_PAGES_PER_SESSION=20

# IDE
IDE_PORT=3002
ENABLE_IDE=true

# Proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=

# Logging
LOG_LEVEL=info
