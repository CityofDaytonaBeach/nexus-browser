# Nexus Browser Configuration

# Server
PORT=3000
WS_PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# Authentication
JWT_SECRET=your-secret-key-change-this
API_KEY=your-api-key
NEXUS_SECRET_KEY=change-this-32-byte-secret-for-encrypted-connectors

# AI / LLM Configuration
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_PROVIDER=openai
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
GROQ_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
HUGGINGFACE_API_KEY=
MOONSHOT_API_KEY=
HYPERBOLIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_AI_PROJECT=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Code Execution Backend
# local = run OpenCode/Codex-compatible CLI on this machine
# remote = call a Codex/OpenCode server over HTTP
# custom = call your own OpenCode-compatible executor server over HTTP
CODE_EXECUTION_MODE=local
CODE_EXECUTION_LOCAL_CLI=opencode
CODE_EXECUTION_LOCAL_ARGS=run
CODE_EXECUTION_REMOTE_URL=
CODE_EXECUTION_REMOTE_API_KEY=
CODE_EXECUTION_REMOTE_KIND=opencode

# GitHub Project Management
GITHUB_TOKEN=ghp-your-token
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/connectors/github/callback
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PROJECT_ID=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_URL=

# Optional Connectors
VERCEL_TOKEN=
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
STRIPE_SECRET_KEY=

# Browser
BROWSER_HEADLESS=false
BROWSER_SLOW_MO=0
BROWSER_VIEWPORT_WIDTH=1920
BROWSER_VIEWPORT_HEIGHT=1080
USER_DATA_DIR=./profiles

# Cloud Mode
CLOUD_MODE=false
MAX_SESSIONS=10
MAX_PAGES_PER_SESSION=20

# IDE
IDE_PORT=3002
ENABLE_IDE=true

# Proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=

# Logging
LOG_LEVEL=info
